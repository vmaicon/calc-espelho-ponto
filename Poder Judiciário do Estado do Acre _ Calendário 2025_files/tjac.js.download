function menu() {
    var tamanhoViewport = $(window).width();
    var menu = $("#navmenu");
    if (tamanhoViewport < 980) { //se é tela pequena
        menu.removeClass("menu");
        menu.addClass("pushy pushy-left");
        menu.children("ul").children("li").addClass("pushy-submenu");
        menu.children("ul").children("li").addClass("pushy-submenu-closed");
        menu.children("ul").children("li").off("click"); //limpa os eventos de click anteriores
        menu.children("ul").children("li").click(function() {
            $(this).toggleClass("pushy-submenu-open");
        });

        var link = menu.children("ul").children("li").children("a");
        for (var i = 0; i <= link.length - 1; i++) {
            $(link[i]).replaceWith(function() {
                return $("<button />").append($(this).contents());
            });
        }

        var submenus = menu.children("ul").children("li").children("div");
        for (var i = 0; i <= submenus.length - 1; i++) {
            $(submenus[i]).replaceWith(function() {
                return $("<ul />").append($(this).contents());
            });
        }

        var item = menu.children("ul").children("li").children("ul").children("span");
        for (var i = 0; i <= item.length - 1; i++) {
            $(item[i]).replaceWith(function() {
                return $("<li />").append($(this).contents());
            });
        }
        menu.children("ul").children("li").children("ul").children("li").addClass("pushy-link");

    } else {
        menu.removeClass("pushy");
        menu.removeClass("pushy-left");
        menu.addClass("menu");
        menu.children("ul").children("li").removeClass("pushy-submenu pushy-submenu-closed pushy-submenu-open");

        var link = menu.children("ul").children("li").children("button");
        for (var i = 0; i <= link.length - 1; i++) {
            $(link[i]).replaceWith(function() {
                return $("<a />").append($(this).contents());
            });
        }

        var submenus = menu.children("ul").children("li").children("ul");
        for (var i = 0; i <= submenus.length - 1; i++) {
            $(submenus[i]).replaceWith(function() {
                return $("<div />").append($(this).contents());
            });
        }

        var item = menu.children("ul").children("li").children("div").children("li");
        for (var i = 0; i <= item.length - 1; i++) {
            $(item[i]).replaceWith(function() {
                return $("<span />").append($(this).contents());
            });
        }
        var item = menu.children("ul").children("li").children("div").children("span").addClass("col-sm-3 tj-menu-coluna tj-menu-colBord");
        $("body").removeClass("pushy-open-right");
    }

}


$(document).ready(function() {
    menu();
    $(window).resize(function() {
        menu();
    });

    //Carousel Noticias

    var clickEvent = false;
    $('#myCarousel').on('click', '.list-group li', function() {
        clickEvent = true;
        $('.list-group li').removeClass('active');
        $(this).addClass('active');
    }).on('slid.bs.carousel', function(e) {
        if (!clickEvent) {
            var count = $('.list-group').children().length - 1;
            var current = $('.list-group li.active');
            current.removeClass('active').next().addClass('active');
            var id = parseInt(current.data('slide-to'));
            if (count == id) {
                $('.list-group li').first().addClass('active');
            }
        }
        clickEvent = false;
    });

    //Fim Carousel Noticias

});


$(window).on('load resize', function() {
    var boxheight = $('#myCarousel .carousel-inner').innerHeight();
    var itemlength = $('#myCarousel .item').length;
    var triggerheight = Math.round(boxheight / itemlength + 1);
    $('#myCarousel .list-group-item').outerHeight(triggerheight);

});

//Voltar ao topo
$(window).scroll(function() {
    if ($(this).scrollTop()) {
        $('#back-to-top').fadeIn();
    } else {
        $('#back-to-top').fadeOut();
    }
});

$("#back-to-top").click(function() {
    $("html, body").animate({ scrollTop: 0 }, 1200);
});
//Consulta Processual 
function consulta(opc) {
    switch (opc) {
        case "PG":
            window.open('https://esaj.tjac.jus.br/cpopg/open.do', '_blank');
            break;
        case "SG":
            window.open('https://esaj.tjac.jus.br/cposg5/open.do', '_blank');
            break;
        case "TR":
            window.open('https://esaj.tjac.jus.br/cposg5/open.do', '_blank');
            break;
    }
}



//Cookie Disclaimer LGPD
$(document).ready(function () {
    //console.log('OK Teste');
    checkCookie();
});


function setCookie() {
    var d = new Date();
    //var exdays = 7;
    var exdays = 1;
    var cname = "tjac";
    var cvalue = "lgpd";
    

     d.setTime(d.getTime() + (exdays * 24 * 60 * 60 * 1000));

    var expires = "expires=" + d.toUTCString();
    //alert(expires);
    document.cookie = cname + "=" + cvalue + ";" + expires + ";path=/";
    document.querySelector(".lgpd").classList.add('hide');
}



function getCookie(cname) {
    var name = cname + "=";
    var decodedCookie = decodeURIComponent(document.cookie);

    var ca = decodedCookie.split(';');
    for (var i = 0; i < ca.length; i++) {
        var c = ca[i];
        while (c.charAt(0) == ' ') {
            c = c.substring(1);
        }
        if (c.indexOf(name) == 0) {
            return c.substring(name.length, c.length);
        }
    }
    return "";
}


function checkCookie() {
    //console.log('OK Teste');
    var user = getCookie("tjac");
    if (user == "lgpd") {
    } else {
        user = "lgpd";
        if (user != "" && user != null) {
            document.querySelector(".lgpd").classList.remove('hide');
        }
    }
}
